diff --git a/qwen3asr/astra_crossover_test.go b/qwen3asr/astra_crossover_test.go
new file mode 100644
index 0000000..d1b5983
--- /dev/null
+++ b/qwen3asr/astra_crossover_test.go
@@ -0,0 +1,113 @@
+package qwen3asr
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/binary"
+	"encoding/hex"
+	"encoding/json"
+	"github.com/GetStream/gophonic/internal/qwen3lm"
+	"github.com/GetStream/gophonic/speech"
+	"math"
+	"os"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestAstraCounterbalancedLatency(t *testing.T) {
+	path := os.Getenv("GOPHONIC_ASTRA_REPORT")
+	if path == "" {
+		t.Skip("opt in")
+	}
+	blocks := 16
+	if s := os.Getenv("GOPHONIC_ASTRA_BLOCKS"); s != "" {
+		blocks, _ = strconv.Atoi(s)
+	}
+	variants := []int{0, 1, 2}
+	if s := os.Getenv("GOPHONIC_ASTRA_VARIANTS"); s != "" {
+		variants = nil
+		for _, v := range strings.Split(s, ",") {
+			n, _ := strconv.Atoi(v)
+			variants = append(variants, n)
+		}
+	}
+	clips := []string{"jfk", "zh"}
+	if s := os.Getenv("GOPHONIC_ASTRA_CLIPS"); s != "" {
+		clips = strings.Split(s, ",")
+	}
+	m := loadModel(t, FormatF16)
+	type sample struct {
+		Clip           string
+		Block, Variant int
+		NS             int64
+		SHA256         string
+	}
+	results := make([]sample, 0, len(clips)*blocks*len(variants))
+	for _, clip := range clips {
+		tr, err := NewTranscriber(m, 0)
+		if err != nil {
+			t.Fatal(err)
+		}
+		pcm := clipPCM(t, clip)
+		var dst speech.Transcript
+		transcribe := func() {
+			t.Helper()
+			if err := tr.Transcribe(context.Background(), pcm, speech.Options{}, &dst); err != nil {
+				t.Fatal(err)
+			}
+		}
+		fingerprint := func() string {
+			h := sha256.New()
+			var bits [8]byte
+			for _, vs := range [][]float32{tr.embeds, tr.hidden, tr.logits} {
+				for _, v := range vs {
+					binary.LittleEndian.PutUint32(bits[:4], math.Float32bits(v))
+					h.Write(bits[:4])
+				}
+			}
+			for _, v := range tr.gen {
+				binary.LittleEndian.PutUint64(bits[:], uint64(v))
+				h.Write(bits[:])
+			}
+			h.Write(dst.Text)
+			return hex.EncodeToString(h.Sum(nil))
+		}
+		qwen3lm.SetAstraVariant(0)
+		for range 3 {
+			transcribe()
+		}
+		expected := fingerprint()
+		t.Logf("%s state SHA256: %s", clip, expected)
+		for block := 0; block < blocks; block++ {
+			for index := range variants {
+				i := (index + block/2) % len(variants)
+				if block%2 != 0 {
+					i = (len(variants) - 1 - index + block/2) % len(variants)
+				}
+				variant := variants[i]
+				qwen3lm.SetAstraVariant(variant)
+				began := time.Now()
+				transcribe()
+				elapsed := time.Since(began)
+				digest := fingerprint()
+				if digest != expected {
+					t.Fatalf("%s block%d variant%d changed state: %s != %s", clip, block, variant, digest, expected)
+				}
+				results = append(results, sample{clip, block, variant, elapsed.Nanoseconds(), digest})
+			}
+			if block%4 == 3 {
+				t.Logf("%s: %d blocks", clip, block+1)
+			}
+		}
+		tr.Close()
+	}
+	raw, err := json.MarshalIndent(results, "", "  ")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = os.WriteFile(path, append(raw, '\n'), 0644); err != nil {
+		t.Fatal(err)
+	}
+}
