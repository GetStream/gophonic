+func TestCPUScratchFootprint(t *testing.T) {
+	path := os.Getenv("STT_SCRATCH_MEMORY")
+	if path == "" {
+		t.Skip("opt in")
+	}
+	attentionSharedScratch = os.Getenv("STT_SCRATCH_SHARED") == "1"
+	m, err := Load(testmodels.Path(t, testmodels.WhisperTinyEN))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer m.Close()
+	tr, err := NewTranscriberWithWorkers(m, 8)
+	if err != nil {
+		t.Fatal(err)
+	}
+	pcmBytes, err := os.ReadFile("../testdata/whisper_jfk.pcm.f32le")
+	if err != nil {
+		t.Fatal(err)
+	}
+	pcm := make([]float32, len(pcmBytes)/4)
+	for i := range pcm {
+		pcm[i] = math.Float32frombits(binary.LittleEndian.Uint32(pcmBytes[4*i:]))
+	}
+	dst := make([]byte, 0, 8192)
+	initialBuffers, initialPoolBytes := whispergemm.ScratchPoolExperiment()
+	for range 3 {
+		if _, err := tr.TranscribeInto(pcm, dst); err != nil {
+			t.Fatal(err)
+		}
+	}
+	buffers, poolBytes := whispergemm.ScratchPoolExperiment()
+	executor := tr.encoder.gemm
+	arenaBytes := executor.ScratchBytesExperiment()
+	tr.Close()
+	afterBuffers, afterPoolBytes := whispergemm.ScratchPoolExperiment()
+	report := map[string]any{"shared": attentionSharedScratch, "initial_buffers": initialBuffers, "initial_pool_bytes": initialPoolBytes, "warm_buffers": buffers, "warm_pool_bytes": poolBytes, "warm_executor_arena_bytes": arenaBytes, "closed_pool_buffers": afterBuffers, "closed_pool_bytes": afterPoolBytes, "closed_executor_arena_bytes": executor.ScratchBytesExperiment()}
+	data, err := json.MarshalIndent(report, "", "  ")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(path, append(data, '\n'), 0644); err != nil {
+		t.Fatal(err)
+	}
+}
