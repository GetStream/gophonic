+package whispergemm
+
+func ScratchPoolExperiment() (int, int) {
+	var buffers [64]*[]float32
+	n, bytes := len(smeScratch), 0
+	for i := 0; i < n; i++ {
+		buffers[i] = <-smeScratch
+		bytes += cap(*buffers[i]) * 4
+	}
+	for i := 0; i < n; i++ {
+		smeScratch <- buffers[i]
+	}
+	return n, bytes
+}
+func (e *Executor) ScratchBytesExperiment() int {
+	if e.memory == nil {
+		return 0
+	}
+	return e.memory.Bytes()
+}
